# Example Splunk searches. Field names depend on your Windows add-on; adjust if needed.
# Index name "wineventlog" is an assumption - change to match your lab.

# 1) Brute force: 5+ failed logons for one account within 5 minutes
index=wineventlog EventCode=4625
| bin _time span=5m
| stats count by _time, Account_Name, Source_Network_Address
| where count >= 5

# 2) Lockouts
index=wineventlog EventCode=4740
| stats count by Account_Name, Caller_Computer_Name

# 3) Someone added to a privileged group
index=wineventlog (EventCode=4728 OR EventCode=4732 OR EventCode=4756)
| table _time, Group_Name, Member_Name, Subject_Account_Name

# 4) New user accounts
index=wineventlog EventCode=4720
| table _time, Target_Account_Name, Subject_Account_Name

# 5) Audit log cleared (high severity)
index=wineventlog EventCode=1102
| table _time, host, Subject_Account_Name
